generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["public", "skillcheck", "axom", "admin"]

}

model Slot {
  id        String     @id @default(cuid())
  startTime DateTime   @unique
  duration  Int
  holdUntil DateTime?
  holdKey   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  status    SlotStatus @default(free)
  session   Session?   @relation("SlotSession")


  @@index([startTime])
  @@index([status, startTime, holdUntil])
  @@index([holdKey, holdUntil])
  @@schema("public")

}

model AvailabilityRule {
  id            String   @id @default(cuid())
  weekday       Int      @unique
  openMinute    Int
  closeMinute   Int
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  @@schema("public")

}

model AvailabilityException {
  id          String   @id @default(cuid())
  date        DateTime
  openMinute  Int?
  closeMinute Int?
  blocked     Boolean  @default(false)

  @@index([date])
  @@schema("public")

}

model Session {
  id               String    @id @default(cuid())
  sessionType      String
  status           String    @default("unpaid")
  slotId           String?   @unique
  liveMinutes      Int
  followups        Int       @default(0)
  riotTag          String
  notes            String?
  createdAt        DateTime  @default(now())
  paymentProvider  String?
  paymentRef       String?   @unique
  amountCents      Int?
  currency         String    @default("eur")
  blockCsv         String?
  scheduledStart   DateTime
  scheduledMinutes Int
  liveBlocks       Int       @default(0)
  waiverAccepted   Boolean   @default(false)
  waiverAcceptedAt DateTime?
  waiverIp         String?
  studentId        String?
  discordId        String?
  discordName      String?
  champions String[] // Add this line


  reminderSent Boolean @default(false)
  followupSent Boolean @default(false)
  confirmationSent Boolean @default(false)
  bookingOwnerSent        Boolean @default(false)


  slot       Slot?       @relation("SlotSession", fields: [slotId], references: [id])
  student    Student?    @relation(fields: [studentId], references: [id])
  sessionDoc SessionDoc? @relation("SessionToDoc")

  couponCode     String?
  couponDiscount Int     @default(0)

  sessionAssets SessionAsset[]

  @@index([createdAt])
  @@index([scheduledStart])
  @@index([riotTag])
  @@index([discordId])
  @@index([studentId])
  @@schema("public")

}

model PendingConfirmationDM {
  discordId String   @id
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@schema("public")

}

model SessionAsset {
  id        String   @id @default(cuid())
  sessionId String
  assetId   String
  createdAt DateTime @default(now())

  session Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  asset   AssetLibrary @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([sessionId, assetId])
  @@index([sessionId])
  @@index([assetId])
  @@schema("public")

}

model ProcessedEvent {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@schema("public")

}

model WebhookEvent {
  id        String   @id @default(cuid())
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@schema("public")

}

model Student {
  id            String         @id @default(cuid())
  name          String         @unique
  puuid         String?        @unique
  server        String?
  riotTag       String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  discordId     String?        @unique
  discordName   String?
  rankSnapshots RankSnapshot[]
  sessions      Session[]
  sessionDocs   SessionDoc[]
  assets        StudentAsset[]
  coupons       Coupon[]

  @@index([puuid])
  @@schema("public")

}

model AssetLibrary {
  id            String         @id @default(cuid())
  name          String
  type          String
  storageKey    String
  url           String
  mime          String?
  size          Int?
  createdAt     DateTime       @default(now())
  students      StudentAsset[]
  sessionAssets SessionAsset[]
  @@schema("public")

}

model StudentAsset {
  id        String       @id @default(cuid())
  studentId String
  assetId   String
  createdAt DateTime     @default(now())
  asset     AssetLibrary @relation(fields: [assetId], references: [id], onDelete: Cascade)
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assetId])
  @@index([studentId])
  @@index([assetId])
  @@schema("public")

}

model RankSnapshot {
  id         String   @id @default(cuid())
  studentId  String
  capturedAt DateTime @default(now())
  tier       String
  division   String?
  lp         Int
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, capturedAt])
  @@index([capturedAt])
  @@schema("public")

}

model SessionDoc {
  id        String   @id @default(cuid())
  studentId String
  number    Int
  notes     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessionId String?  @unique
  session   Session? @relation("SessionToDoc", fields: [sessionId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, number])
  @@index([studentId])
  @@index([sessionId])
  @@schema("public")

}

enum SlotStatus {
  free
  taken
  blocked
  @@schema("public")

}

model Coupon {
  id        String   @id @default(cuid())
  code      String   @unique
  studentId String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@schema("public")

}

/// Stage speed review queue (single table MVP).
model SpeedReviewQueue {
  id              String              @id @default(cuid())
  discordId       String              @unique
  globalName      String?
  discordName     String?
  riotTag         String
  puuid           String?
  role            String
  queueDate       DateTime            @default(now())
  previousReviews Int                 @default(0)
  paidPriority    Boolean             @default(false)
  optOut          Boolean             @default(false)
  reviewStatus    SpeedReviewStatus   @default(Pending)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([reviewStatus, paidPriority])
  @@index([queueDate])
  @@index([discordId])
  @@index([puuid])
  @@schema("public")
}

enum SpeedReviewStatus {
  Pending
  Done

  @@schema("public")
}

/// Singleton row id = "default" — next public Stage review time.
model SpeedReviewConfig {
  id            String    @id @default("default")
  nextSessionAt DateTime?
  reminder24hSent Boolean @default(false)
  updatedAt     DateTime  @updatedAt

  @@schema("public")
}
model Draft {
  id        String   @id @default(cuid())

  blue      Json
  red       Json

  role      String
  userTeam  String

  answers   Json   // DraftAnswer[]

  usedLast        DateTime?
  attempts        Int      @default(0)
  correctAttempts Int      @default(0)
  likes           Int      @default(0)
  dislikes        Int      @default(0)

  status     DraftStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  submitIp   String?
  madeBy     String?

  @@schema("skillcheck")
}



enum DraftStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("skillcheck")
}
model CooldownStat {
  id              String   @id @default(cuid())

  championId      String
  spellKey        String
  rank            Int

  attempts        Int      @default(0)
  correctAttempts Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([championId, spellKey, rank])
  @@index([championId])
  @@schema("skillcheck")
}

model ItemStat {
  id               String   @id @default(cuid())
  dayKey           String   // YYYY-MM-DD (UTC)
  itemId           String   // target item id for the day
  attempts         Int      @default(0)
  correctAttempts  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([dayKey, itemId])
  @@index([dayKey])
  @@schema("skillcheck")
}

model RuneDaily {
  dayKey      String    @id // YYYY-MM-DD (UTC)
  championId  String    // champion key e.g. Aatrox
  keystoneId  Int       // rune perk id (primary slot 0)
  sampledAt   DateTime? // when Riot sampling ran
  errorLog    String?   // last error if sampling failed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@schema("skillcheck")
}

model RuneStat {
  id               String   @id @default(cuid())
  dayKey           String
  championId       String
  attempts         Int      @default(0)
  correctAttempts  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([dayKey, championId])
  @@index([dayKey])
  @@schema("skillcheck")
}

model LeaderboardEntry {
  id          String   @id @default(cuid())
  clientId    String   @unique // persistent id from client (e.g. localStorage)
  displayName String?  // user can set on leaderboard page
  streakDays  Int      @default(0)
  updatedAt   DateTime @updatedAt

  // Per-mode attempt stats for avg attempts on leaderboard (attempts / correctAttempts)
  draftAttempts       Int @default(0)
  draftCorrectAttempts Int @default(0)
  runesAttempts       Int @default(0)
  runesCorrectAttempts Int @default(0)
  cooldownsAttempts   Int @default(0)
  cooldownsCorrectAttempts Int @default(0)
  itemsAttempts       Int @default(0)
  itemsCorrectAttempts Int @default(0)

  @@index([streakDays(sort: Desc)])
  @@schema("skillcheck")
}

/// Singleton row id = "default" — site-wide toggles (e.g. manual Twitch live on guide).
model SiteConfig {
  id                 String   @id @default("default")
  twitchLiveManual   Boolean  @default(false)
  twitchStreamTitle  String?
  updatedAt          DateTime @updatedAt

  @@schema("public")
}

model SocialIdea {
  checklist Json @default("[]")
  plannedDate String?
  placedAt DateTime?
  sortOrder Int @default(0)
  id        String   @id @default(cuid())
  title     String
  notes     String   @default("")
  platform  String
  status    String   @default("idea")
  energy    Int?
  dueDate   String?
  reference String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([platform, sortOrder])
  @@schema("admin")
}

model WhatNowCategory {
  id            String   @id
  label         String
  defaultEnergy Int
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("admin")
}

model WhatNowChoice {
  id          String   @id @default(cuid())
  questionId  String
  label       String
  next        String?
  minEnergy   Int?
  maxEnergy   Int?
  categories  String[]
  sortOrder   Int      @default(0)

  @@index([questionId, sortOrder])
  @@schema("admin")
}

model WhatNowQuestion {
  id        String @id
  prompt    String
  sortOrder Int    @default(0)

  @@schema("admin")
}

model WhatNowTask {
  id           String   @id @default(cuid())
  title        String
  description  String   @default("")
  energy       Int?
  category     String
  subcategory  String   @default("")
  steps        Json     @default("[]")
  private      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([energy])
  @@index([category, subcategory])
  @@schema("admin")
}

model Recipe {
  id             String             @id @default(cuid())
  slug           String             @unique
  title          String
  familyKey      String?
  familyTitle    String?
  variantLabel   String?
  summary        String             @default("")
  servings       Int?               @default(2)
  prepMinutes    Int                @default(0)
  cookMinutes    Int                @default(0)
  tags           String[]           @default([])
  notes          String             @default("")
  referenceImage String             @default("")
  calories       Int?
  proteinGrams   Float?
  carbsGrams     Float?
  fatGrams       Float?
  nutrition      RecipeNutrition?
  ingredients    RecipeIngredient[]
  steps          RecipeStep[]
  mealPlans      MealPlan[]
  cooks          RecipeCook[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([title])
  @@index([familyKey])
  @@schema("admin")
}

model RecipeNutrition {
  id              String   @id @default(cuid())
  recipeId        String   @unique
  recipe          Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  calories        Float?
  proteinGrams    Float?
  carbsGrams      Float?
  fatGrams        Float?
  fibreGrams      Float?
  saturatedFatGrams Float?
  sugarGrams      Float?
  sodiumMg        Float?
  potassiumMg     Float?
  calciumMg       Float?
  magnesiumMg     Float?
  ironMg          Float?
  zincMg          Float?
  vitaminDMcg     Float?
  vitaminB12McG   Float?
  folateMcg       Float?
  iodineMcg       Float?
  omega3AlAGrams  Float?
  omega3EpaDhaMg  Float?
  basis           String   @default("per serving")
  updatedAt       DateTime @updatedAt

  @@schema("admin")
}

model DailyNutritionTarget {
  id              String   @id @default(cuid())
  calories        Float?
  proteinGrams    Float?
  carbsGrams      Float?
  fatGrams        Float?
  fibreGrams      Float?
  sodiumMg        Float?
  potassiumMg     Float?
  calciumMg       Float?
  magnesiumMg     Float?
  ironMg          Float?
  zincMg          Float?
  vitaminDMcg     Float?
  vitaminB12McG   Float?
  folateMcg       Float?
  iodineMcg       Float?
  omega3AlAGrams  Float?
  omega3EpaDhaMg  Float?
  trainingDay     Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@unique([trainingDay])
  @@schema("admin")
}

model RecipeIngredient {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  groceryItemId String?
  groceryItem   GroceryItem? @relation(fields: [groceryItemId], references: [id], onDelete: SetNull)
  quantity      Decimal?
  weightGrams   Decimal? @db.Decimal(12, 3)
  count         Decimal? @db.Decimal(12, 6)
  // Optional recipe-specific override; count labels remain recipe display text.
  gramsPerCount Decimal? @db.Decimal(12, 3)
  amount   String @default("")
  unit     String @default("")
  name     String
  note     String @default("")
  optional Boolean @default(false)
  sortOrder Int   @default(0)

  @@index([recipeId, sortOrder])
  @@index([groceryItemId])
  @@schema("admin")
}

model RecipeStep {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  text     String
  sortOrder Int   @default(0)

  @@index([recipeId, sortOrder])
  @@schema("admin")
}

model GroceryItem {
  id          String             @id @default(cuid())
  name        String
  category    String             @default("")
  gramsPerCount Decimal?         @db.Decimal(12, 3)
  weightBasis String            @default("")
  // Nutrient keys match RecipeNutrition; missing keys mean unknown, not zero.
  nutritionPer100g Json?
  nutritionSource String        @default("")
  ingredients RecipeIngredient[]
  lots        GroceryLot[]
  shoppingItem ShoppingItem?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([name])
  @@schema("admin")
}

model GroceryLot {
  id              String                @id @default(cuid())
  groceryItemId   String
  groceryItem     GroceryItem           @relation(fields: [groceryItemId], references: [id], onDelete: Cascade)
  purchasedAmount String
  remainingAmount String
  purchasedCount Decimal?             @db.Decimal(12, 6)
  remainingCount Decimal?             @db.Decimal(12, 6)
  purchasedWeightGrams Decimal?         @db.Decimal(12, 3)
  remainingWeightGrams Decimal?         @db.Decimal(12, 3)
  purchasedAt     DateTime              @default(now())
  openedAt        DateTime?
  usualShelfLifeDays Int?
  expiresAt       DateTime?
  reservations    GroceryReservation[]
  transactions    GroceryTransaction[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([groceryItemId, expiresAt])
  @@schema("admin")
}

model ShoppingItem {
  id            String      @id @default(cuid())
  groceryItemId String      @unique
  groceryItem   GroceryItem @relation(fields: [groceryItemId], references: [id], onDelete: Cascade)
  grams         Decimal     @db.Decimal(12, 3)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@schema("admin")
}

model MealPlan {
  id           String                @id @default(cuid())
  recipeId     String
  recipe       Recipe                @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  plannedDate  String
  mealSlot     String
  servings     Int                   @default(1)
  addonRecipeId String?
  // "planned" claims raw groceries; "cooked" is fully covered by portions in the fridge.
  status       String                @default("planned")
  // How many of this slot's servings came from an already-cooked batch.
  cookedServings Int                 @default(0)
  recipeCookId String?
  recipeCook   RecipeCook?           @relation(fields: [recipeCookId], references: [id], onDelete: SetNull)
  cookedAt     DateTime?
  reservations GroceryReservation[]
  transactions GroceryTransaction[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([plannedDate, status])
  @@index([recipeId, plannedDate])
  @@index([recipeCookId])
  @@unique([plannedDate, mealSlot])
  @@schema("admin")
}

model GroceryReservation {
  id         String     @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan   @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  groceryLotId String
  groceryLot GroceryLot @relation(fields: [groceryLotId], references: [id], onDelete: Cascade)
  amount     Decimal    @db.Decimal(12, 3)
  createdAt  DateTime   @default(now())

  @@unique([mealPlanId, groceryLotId])
  @@index([groceryLotId])
  @@schema("admin")
}

model GroceryTransaction {
  id         String      @id @default(cuid())
  groceryLotId String
  groceryLot GroceryLot  @relation(fields: [groceryLotId], references: [id], onDelete: Cascade)
  mealPlanId String?
  mealPlan   MealPlan?   @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)
  amountDelta Decimal    @db.Decimal(12, 3)
  reason     String
  recipeCookId String?
  recipeCook RecipeCook? @relation(fields: [recipeCookId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([groceryLotId, createdAt])
  @@index([mealPlanId])
  @@schema("admin")
}

model RecipeCook {
  // Client-generated request ID makes retries safe.
  id String @id
  recipeId String
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  servings Float
  // Portions still in the fridge, not yet assigned to a planned meal.
  remainingServings Float @default(0)
  createdAt DateTime @default(now())
  transactions GroceryTransaction[]
  mealPlans MealPlan[]

  @@index([recipeId])
  @@schema("admin")
}

model AxomEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String
  for       String   @map("for")

  @@schema("axom")
  @@map("events")
}
